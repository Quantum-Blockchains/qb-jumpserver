# QB JUMP SERVER - FULL DEPLOYMENT (with Keycloak)
# Deploys: Jump Server + Keycloak + PostgreSQL
# Steps: cp env/full .env → edit .env → docker compose -f docker-compose-full.yml up -d

# REQUIRED SETTINGS
JUMP_SERVER_HOST=localhost            # Update to your server IP/hostname
JUMP_SERVER_PORT=8443
JUMP_SERVER_PORT_HOST=8443
JUMP_SERVER_TITLE=QB Jump Server
ENVIRONMENT=development               # development, production
DOCKER_NETWORK=jump-server-network

# SSL/TLS
HTTPS_ENABLED=false
SSL_CERT_PATH=./tls.crt
SSL_KEY_PATH=./tls.key

# OIDC AUTHENTICATION
OIDC_ENABLED=true
OIDC_BASE_URL=http://localhost:8081
OIDC_REALM=jump-server
OIDC_CLIENT_ID=jump-server
OIDC_CLIENT_SECRET=CHANGE_THIS_AFTER_KEYCLOAK_SETUP  # ⚠️ UPDATE after Keycloak setup

# SESSION MANAGEMENT
SESSION_LIFETIME=0s                   # 0 = no absolute timeout
SESSION_ROLLING_TIMEOUT=120m          # Session extends by 120 minutes on activity

# MONITORING
MONITORING_CLEANUP_INTERVAL=60s
MONITORING_RETENTION=10m
LOG_LEVEL=INFO

# KEYCLOAK CONFIGURATION
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_EXTERNAL_URL=http://localhost:8081
KEYCLOAK_PORT=8081
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HOSTNAME_URL=http://localhost:8081
KC_PROXY=edge
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak
